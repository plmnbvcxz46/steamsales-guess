<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>clean_steam_games</name>
    <description>Steam原始数据清洗与对齐转换：过滤免费游戏、Demo、非游戏软件与异常价格，计算实测系数k</description>
    <extended_description>课程大作业：基于ETL的Steam游戏销量估算与智能分析系统</extended_description>
    <trans_version>1.0</trans_version>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
  </info>
  <connection>
    <name>Steam_MySQL_DW</name>
    <server>localhost</server>
    <type>MYSQL</type>
    <access>Native</access>
    <database>steam_sales_dw</database>
    <port>3306</port>
    <username>root</username>
    <password>Encrypted 2be98afc86aa7f2e4cb79ce10cc9da0ce</password>
  </connection>
  <order>
    <hop>
      <from>CSV文件输入_2018玩家快照与评测表</from>
      <to>过滤记录_剔除免费游戏与Demo及异常值</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>过滤记录_剔除免费游戏与Demo及异常值</from>
      <to>计算器_求解实测系数k与对数特征</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>过滤记录_剔除免费游戏与Demo及异常值</from>
      <to>表输出_清洗异常审计日志表(etl_clean_error_log)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>计算器_求解实测系数k与对数特征</from>
      <to>表输出_明细层宽表(dwd_steam_game_aligned)</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>CSV文件输入_2018玩家快照与评测表</name>
    <type>CsvInput</type>
    <description>读取2018-07-01对齐的玩家数与评测统计CSV文件</description>
    <filename>${Internal.Entry.Current.Directory}/../data/raw/games_achievements_players_2018-07-01.csv</filename>
    <delimiter>,</delimiter>
    <enclosure>"</enclosure>
    <header>Y</header>
    <encoding>UTF-8</encoding>
    <fields>
      <field><name>appid</name><type>Integer</type></field>
      <field><name>name</name><type>String</type></field>
      <field><name>players_2018_07_01</name><type>Integer</type></field>
      <field><name>is_free</name><type>Integer</type></field>
      <field><name>app_type</name><type>String</type></field>
      <field><name>price_usd</name><type>Number</type></field>
      <field><name>total_reviews_2018</name><type>Integer</type></field>
    </fields>
  </step>
  <step>
    <name>过滤记录_剔除免费游戏与Demo及异常值</name>
    <type>FilterRows</type>
    <description>条件：is_free = 0 AND app_type = 'game' AND price_usd > 0 AND total_reviews_2018 > 0</description>
    <send_true_to>计算器_求解实测系数k与对数特征</send_true_to>
    <send_false_to>表输出_清洗异常审计日志表(etl_clean_error_log)</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <conditions>
          <condition><leftvalue>is_free</leftvalue><function>=</function><rightvalue/><value><name>constant</name><type>Integer</type><text>0</text></value></condition>
          <condition><operator>AND</operator><leftvalue>app_type</leftvalue><function>=</function><rightvalue/><value><name>constant</name><type>String</type><text>game</text></value></condition>
          <condition><operator>AND</operator><leftvalue>price_usd</leftvalue><function>&gt;</function><rightvalue/><value><name>constant</name><type>Number</type><text>0.0</text></value></condition>
          <condition><operator>AND</operator><leftvalue>total_reviews_2018</leftvalue><function>&gt;</function><rightvalue/><value><name>constant</name><type>Integer</type><text>0</text></value></condition>
        </conditions>
      </condition>
    </compare>
  </step>
  <step>
    <name>计算器_求解实测系数k与对数特征</name>
    <type>Calculator</type>
    <description>计算 k_ratio = players_2018_07_01 / total_reviews_2018</description>
    <calculation>
      <field_name>k_ratio</field_name>
      <calc_type>DIVIDE</calc_type>
      <field_a>players_2018_07_01</field_a>
      <field_b>total_reviews_2018</field_b>
      <value_type>Number</value_type>
    </calculation>
  </step>
  <step>
    <name>表输出_明细层宽表(dwd_steam_game_aligned)</name>
    <type>TableOutput</type>
    <connection>Steam_MySQL_DW</connection>
    <table>dwd_steam_game_aligned</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
  </step>
  <step>
    <name>表输出_清洗异常审计日志表(etl_clean_error_log)</name>
    <type>TableOutput</type>
    <connection>Steam_MySQL_DW</connection>
    <table>etl_clean_error_log</table>
    <commit>500</commit>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
  </step>
</transformation>
